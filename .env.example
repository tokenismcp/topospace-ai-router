# ---------------------------------------------------------------------------
# TopoSpace MCP: environment contract
#
# Every variable below is a hypothesis of a guarantee.  The service refuses to
# boot on combinations that would leave a documented guarantee unmet; run
# `topospace check` to validate a configuration before deploying it.
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
TOPOSPACE_ENV=development                 # development | staging | production
TOPOSPACE_TENANT_ID=default
TOPOSPACE_API_KEY=                        # bootstrap customer credential (required)
TOPOSPACE_KEY_PEPPER=                     # >= 16 bytes; server-side pepper for key hashes

# --- providers --------------------------------------------------------------
PRIMARY_PROVIDER_NAME=primary
PRIMARY_PROVIDER_BASE_URL=https://api.openai.com/v1
PRIMARY_PROVIDER_API_KEY=
# Optional second provider.  Independence from the primary is the hypothesis of
# the retry/fallback reliability result; shared credentials or shared egress
# reintroduce the common-mode floor.
FALLBACK_PROVIDER_NAME=fallback
FALLBACK_PROVIDER_BASE_URL=
FALLBACK_PROVIDER_API_KEY=

PROVIDER_RETRIES=2                        # retry budget k (amplifies load when degraded)
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_BREAKER_FAILURES=5               # consecutive failures before the breaker trips
PROVIDER_BREAKER_OPEN_SECONDS=10          # breaker timeout tau

# Development only.  A deterministic provider has zero variance and unbounded
# bias as a measurement instrument: any figure derived from it is void.
ALLOW_MOCK_PROVIDER=false

# --- admission and quota ----------------------------------------------------
TOPOSPACE_RPM=60                          # sustained rate r (requests/minute)
TOPOSPACE_BURST_SECONDS=10                # burst capacity c, expressed in seconds of r
TOPOSPACE_MONTHLY_TOKEN_LIMIT=1000000
TOPOSPACE_MONTHLY_COST_LIMIT=100          # USD
TOPOSPACE_MAX_REQUEST_BYTES=1048576

# --- delegation and compatibility -------------------------------------------
# Accept a per-request provider credential (X-Provider-Api-Key). This is the
# bring-your-own-key commercial model: the customer keeps their provider
# contract and the plane supplies the optimisation layer.
TOPOSPACE_BYOK=false

# Expose the 1.3.0-beta1 internal sidecar contract so an existing Node
# deployment can point at the engine and delete its Python supervisor.
# Turn it off once migrated.
TOPOSPACE_COMPAT_SIDECAR=false
TOPOSPACE_INTERNAL_SECRET=

# Capacity this deployment can actually serve, in requests per second. Used to
# check the provisioning invariant when tenant plans are set; 0 disables the
# check, because a made-up capacity would make the check theatre.
TOPOSPACE_SERVICE_RATE_PER_SECOND=0

# --- pricing ----------------------------------------------------------------
# REQUIRED IN PRODUCTION. A JSON file path or inline JSON, in micro-USD per 1000
# tokens: {"gpt-4o": {"input": 2500, "output": 10000}}. The built-in prices on
# the model catalogue are development values, not your contract, and every
# routing decision, quota figure and ledger row derives from this table.
TOPOSPACE_PRICE_BOOK=

# --- evaluation -------------------------------------------------------------
# heuristic          truncation and emptiness only; NOT an evaluator, so the
#                    promotion gate's quality guardrail stays inert
# structural         deterministic checks against per-request `topospace_expect`
# rubric             model-graded, sampled, off the request path
# structural+rubric  both, with success as the conjunction
TOPOSPACE_JUDGE=heuristic
TOPOSPACE_JUDGE_MODEL=                    # required when a rubric judge is selected
TOPOSPACE_JUDGE_SAMPLE_RATE=0.1           # fraction of traffic graded
TOPOSPACE_JUDGE_BUDGET_USD=5              # per-day ceiling on grading spend

# --- budget bounds ----------------------------------------------------------
TOPOSPACE_MIN_BUDGET_TOKENS=128
TOPOSPACE_MAX_BUDGET_TOKENS=4096
TOPOSPACE_CONTEXT_BUDGET_TOKENS=6000

# --- datasets ---------------------------------------------------------------
# A corpus lets a request name a dataset instead of passing candidates: an
# evaluation affordance, not a replacement for your retrieval layer.
TOPOSPACE_CORPUS_PATH=                    # file or directory to load at boot
TOPOSPACE_CORPUS_NAME=default             # the name that path is registered under
TOPOSPACE_CORPUS_BUNDLED=true             # also load the datasets shipped in the package
# Coverage rule: satisfaction | additive | empty for auto (additive for a single
# aspect, satisfaction otherwise).  The additive rule returns several documents
# but depends on the absolute separation your embeddings give; on the built-in
# lexical fallback, pin satisfaction if you want precision over recall.
TOPOSPACE_COVERAGE=
TOPOSPACE_CORPUS_MAX_OBJECTS=20000        # ceiling on any one corpus
TOPOSPACE_CORPUS_UPLOAD=false             # accept datasets over HTTP; refused in production

# --- infrastructure ---------------------------------------------------------
# SQLite path, or a postgres:// URL.  PostgreSQL is required with > 1 replica.
TOPOSPACE_DATABASE_URL=topospace.db
# Required with > 1 replica: in-process buckets would admit N x each tenant's rate.
TOPOSPACE_REDIS_URL=
TOPOSPACE_REPLICAS=1
TOPOSPACE_EPHEMERAL_STORAGE=false         # must be false in production

# --- policy operations ------------------------------------------------------
TOPOSPACE_EXPLORATION_RATE=0.0            # 0..0.25; the price of being able to certify challengers
TOPOSPACE_PROMOTION_ALPHA=0.05            # anytime-valid error level
TOPOSPACE_ENABLE_ADMIN_API=true

# Operator console at /console. An administrative surface, so it follows the
# same rule as the rest: on outside production, explicit inside it.
TOPOSPACE_ENABLE_CONSOLE=

# --- runtime ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
TOPOSPACE_LOG_LEVEL=INFO

# --- integration tests (optional) -------------------------------------------
# When set, the distributed test suite runs against real servers instead of
# skipping: only a real server can check atomicity under contention.
TOPOSPACE_TEST_REDIS_URL=
TOPOSPACE_TEST_POSTGRES_DSN=

# --- live provider tests (optional, these cost money) ------------------------
# Never paste a key into a chat, ticket or commit.
TOPOSPACE_LIVE_PROVIDER_KEY=
TOPOSPACE_LIVE_PROVIDER_BASE_URL=https://api.openai.com/v1
TOPOSPACE_LIVE_MODEL=gpt-4o-mini
TOPOSPACE_LIVE_MAX_TOKENS=64

# --- Local models  ---------------------------------------
# Serve from GGUF files on this machine; llama-server runs the weights.
# TOPOSPACE_FLEET=true
# TOPOSPACE_FLEET_MEMORY_GB=8          # default: half of physical memory
# TOPOSPACE_FLEET_DIRS=/models         # extra .gguf directories, ':'-separated
# TOPOSPACE_FLEET_BINARY=              # default: PATH, then Ollama.app's copy
# TOPOSPACE_FLEET_IDLE_SECONDS=900
# TOPOSPACE_FLEET_REASONING=false      # let reasoning models think
# TOPOSPACE_FLEET_CAPABILITY=capability.json   # from `topospace fleet-calibrate`

# --- Retrieval  --------------------------------------------
# TOPOSPACE_RELATIVE_RADIUS=0.6        # 0 restores the absolute radius
# TOPOSPACE_EMBEDDER=openai            # default: built-in hashing
# TOPOSPACE_EMBEDDER_URL=http://127.0.0.1:11434/v1
# TOPOSPACE_EMBEDDER_MODEL=nomic-embed-text
